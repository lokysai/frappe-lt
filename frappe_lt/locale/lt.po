msgstr "Ši nuoroda netinkama arba nebegalioja. Įsitikinkite, kad ją įklijavote teisingai."

msgid "This link is valid for {0} minutes"
msgstr "Ši nuoroda galioja {0} min."

msgid "This may get printed on multiple pages"
msgstr "Tai gali būti atspausdinta keliuose puslapiuose"

