msgstr "Šiame dokumento tipe nėra atsietų laukų, kuriuos būtų galima pašalinti"

msgid "This doctype has pending migrations, run 'bench migrate' before modifying the doctype to avoid losing changes."
msgstr "Šio dokumento tipo duomenų perkėlimas dar nebaigtas. Prieš keisdami dokumento tipą paleiskite „bench migrate“, kad neprarastumėte pakeitimų."

msgid "This document can not be deleted right now as it's being modified by another user. Please try again after some time."
msgstr "Šio dokumento dabar negalima ištrinti, nes jį keičia kitas naudotojas. Bandykite dar kartą vėliau."

msgid "This document has already been queued for submission. You can track the progress over {0}."
msgstr "Šis dokumentas jau įtrauktas į patvirtinimo eilę. Vykdymo eigą galite stebėti čia: {0}."

msgid "This document has been modified after the email was sent."
msgstr "Šis dokumentas buvo pakeistas išsiuntus el. laišką."

msgid "This document has unsaved changes which might not appear in final PDF. <br> Consider saving the document before printing."
msgstr "Šiame dokumente yra neišsaugotų pakeitimų, kurių galutiniame PDF faile gali nesimatyti. <br> Prieš spausdindami apsvarstykite galimybę išsaugoti dokumentą."

msgid "This document is already amended, you cannot ammend it again"
msgstr "Šiam dokumentui jau sukurtas pataisytas egzempliorius, todėl negalite jo taisyti dar kartą"

msgid "This document is currently locked and queued for execution. Please try again after some time."
msgstr "Šis dokumentas dabar užrakintas ir įtrauktas į vykdymo eilę. Bandykite dar kartą vėliau."

msgid "This document is over limit by {0} {1} for item {4}. Are you making another {3} against the same {2}?"
msgstr "Šiame dokumente prekės {4} limitas viršytas {0} {1}. Ar kuriate kitą {3} pagal tą patį {2}?"

msgid "This email is autogenerated"
msgstr "Šis el. laiškas sugeneruotas automatiškai"

msgid "This email was sent from {0}"
msgstr "Šis el. laiškas išsiųstas iš {0}"

msgid ""
"This feature can not be used as dependencies are missing.\n"
"\t\t\t\tPlease contact your system manager to enable this by installing pycups!"
msgstr ""
"Šios funkcijos negalima naudoti, nes trūksta priklausomybių.\n"
"\t\t\t\tSusisiekite su sistemos administratoriumi, kad jis įdiegtų pycups ir įjungtų šią funkciją!"

msgid "This feature is brand new and still experimental"
msgstr "Ši funkcija yra visiškai nauja ir vis dar eksperimentinė"

msgid "This field is used to set the 'Customer'."
msgstr "Šis laukas naudojamas laukui „Klientas“ nustatyti."

msgid ""
"This field will appear only if the fieldname defined here has value OR the rules are true (examples):\n"
"myfield\n"
"eval:doc.myfield=='My Value'\n"
"eval:doc.age&gt;18"
msgstr ""
"Šis laukas bus rodomas tik tada, jei čia nurodytas laukas turi reikšmę ARBA tenkinamos taisyklės (pavyzdžiai):\n"
"myfield\n"
"eval:doc.myfield=='My Value'\n"
"eval:doc.age&gt;18"

