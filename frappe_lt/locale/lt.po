msgstr "Šis metodas skirtas tik kūrėjo režimui"

msgid "This module is scheduled for deprecation and will be completely removed in version 17, please use <a href=\"https://frappe.io/crm\">Frappe CRM</a> instead."
msgstr "Šio modulio palaikymą planuojama nutraukti, o 17 versijoje jis bus visiškai pašalintas, todėl naudokite <a href=\"https://frappe.io/crm\">Frappe CRM</a> vietoj jo."

msgid "This module is scheduled for deprecation and will be completely removed in version 17, please use <a href=\"https://frappe.io/helpdesk\">Frappe Helpdesk</a> instead."
msgstr "Šio modulio planuojama atsisakyti ir 17 versijoje jis bus visiškai pašalintas, todėl vietoje jo naudokite <a href=\"https://frappe.io/helpdesk\">Frappe Helpdesk</a> sistemą."

msgid "This month"
